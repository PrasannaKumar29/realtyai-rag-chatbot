# Populate only in process/hosting secrets, never in Docker build arguments.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_ENABLE_FALLBACK=false
CHROMA_COLLECTION=real_estate_knowledge
# Docker sets these absolute paths; omit locally to use repository defaults.
CHROMA_PATH=/opt/realtyai/runtime_assets/chroma
CHUNKS_PATH=/opt/realtyai/runtime_assets/chunks.jsonl
TOKENIZER_CACHE=/opt/realtyai/runtime_assets/tokenizer
WASALT_LISTINGS_PATH=/opt/realtyai/runtime_assets/listings.jsonl
PORT=10000
